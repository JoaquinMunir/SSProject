<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="TIProject.styles.css" />
    <link rel="stylesheet" href="css/dashboard.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Fix para que reCAPTCHA funcione con la navegación mejorada de Blazor 8
        document.addEventListener('autostart', () => {
            Blazor.addEventListener('enhancedload', () => {
                if (window.grecaptcha && document.querySelector('.g-recaptcha')) {
                    try {
                        grecaptcha.render(document.querySelector('.g-recaptcha'));
                    } catch (e) {
                        // Ya estaba renderizado o falló
                    }
                }
            });
        });
    </script>
    <script src="js/site.js"></script>
</body>

</html>
