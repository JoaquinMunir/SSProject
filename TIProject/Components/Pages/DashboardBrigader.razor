@page "/dashboard_brigader"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "brigader")]
@inject IRepoUsers RepoUsers

<PageTitle>Panel de Brigadista</PageTitle>

<PanelShell CurrentUser="_currentUser" Active="/dashboard_brigader">
    <h1>Panel de Brigadista</h1>
    <p>Brigada: <strong>@(_currentUser.Brigade?.GetDisplayName() ?? "Sin asignar")</strong>. Inscríbete a las capacitaciones de Protección Civil.</p>

    @if (_currentUser.Id != 0)
    {
        <CourseEnrollmentPanel UserId="_currentUser.Id" />
    }

</PanelShell>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User _currentUser = new();

    private async Task CargarUsuarioActual()
    {
        if (AuthStateTask is null) return;
        var authState = await AuthStateTask;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userId, out int id))
        {
            var user = await RepoUsers.Get(id);
            if (user is not null) _currentUser = user;
        }
    }

    protected override async Task OnInitializedAsync() => await CargarUsuarioActual();
}
