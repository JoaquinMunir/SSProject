@page "/dashboard_brigader"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "brigader")]
@inject NavigationManager Navigation
@inject IRepoCourses RepoCourses
@inject IRepoUsers RepoUsers
@inject IJSRuntime JS

<HeadContent>
    <link href="css/dashboardIndex.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</HeadContent>

<div class="dashboard-layout">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo"><i class="fas fa-hard-hat"></i></div>
            <div class="logo-text"><h1>Brigadista</h1></div>
        </div>
        <nav>
            <button class="menu-item active"><i class="fas fa-fire-extinguisher"></i><span>Capacitación</span></button>
            <button class="menu-item" onclick="location.href='/account/logout'">
                <i class="fas fa-sign-out-alt"></i><span>Salir</span>
            </button>
        </nav>
    </aside>

    <div class="main-area">
        <header class="header">
            <div class="header-actions">
                <div class="user-avatar" style="background-color: #e67e22;">
                    @(_currentUser.Name?.FirstOrDefault().ToString().ToUpper() ?? "B")
                </div>
                <span style="margin-left:10px; font-weight:bold;">@_currentUser.Name (@_currentUser.Brigade)</span>
            </div>
        </header>

        <main class="main-content">
            <div class="dashboard-content">
                <h1>Panel de Brigadista</h1>
                <p>Cursos obligatorios y opcionales para tu brigada.</p>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 20px;">
                    @foreach (var course in availableCourses)
                    {
                        <div class="card p-3 shadow-sm" style="border-top: 4px solid #e67e22;">
                            <h5 class="fw-bold">@course.Name</h5>
                            <p class="small mb-2"><i class="fas fa-map-marker-alt"></i> @course.Place</p>
                            <p class="small mb-3"><i class="far fa-calendar"></i> @course.Date.ToString("dd MMM yyyy")</p>
                            <button class="btn btn-warning w-100 text-white" @onclick="() => Inscribirse(course)">
                                <i class="fas fa-pencil-alt"></i> Registrar Asistencia
                            </button>
                        </div>
                    }
                </div>
            </div>
        </main>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User _currentUser = new();
    private List<Course> availableCourses = new();

    protected override async Task OnInitializedAsync()
    {
        availableCourses = await RepoCourses.GetAll();

        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (int.TryParse(userId, out int id))
            {
                var user = await RepoUsers.Get(id);
                if (user is not null) _currentUser = user;
            }
        }
    }

    private async Task Inscribirse(Course course)
    {
        await JS.InvokeVoidAsync("alert", $"Registrado en: {course.Name}");
    }
}
