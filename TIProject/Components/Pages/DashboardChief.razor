@page "/dashboard_chief"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "brigaderChief")]
@inject IRepoUsers RepoUsers

<PageTitle>Panel de Jefe de Brigada</PageTitle>

<PanelShell CurrentUser="_currentUser" Active="/dashboard_chief">
    <h1>Personal a Cargo</h1>
    <p>Usuarios registrados en: <strong>@_currentUser.School</strong></p>

    @if (usersInMySchool.Any())
    {
        <div class="card p-3">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Rol</th>
                        <th>Brigada</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in usersInMySchool)
                    {
                        <tr>
                            <td>@user.Name</td>
                            <td><span class="badge bg-secondary">@user.Role.GetDisplayName()</span></td>
                            <td>
                                @if (user.Brigade != null)
                                {
                                    <span class="badge bg-info text-dark">@user.Brigade.GetDisplayName()</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">No se encontraron usuarios en tu facultad o escuela.</div>
    }

</PanelShell>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User _currentUser = new();

    private async Task CargarUsuarioActual()
    {
        if (AuthStateTask is null) return;
        var authState = await AuthStateTask;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userId, out int id))
        {
            var user = await RepoUsers.Get(id);
            if (user is not null) _currentUser = user;
        }
    }

    private List<User> usersInMySchool = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarioActual();
        if (string.IsNullOrEmpty(_currentUser.School)) return;

        var allUsers = await RepoUsers.GetAll();
        usersInMySchool = allUsers
            .Where(u => u.School == _currentUser.School && u.Id != _currentUser.Id)
            .OrderBy(u => u.Name)
            .ToList();
    }
}
