@page "/dashboard_chief"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "brigaderChief")]
@inject IRepoUsers RepoUsers
@inject NavigationManager Navigation

<HeadContent>
    <link href="css/dashboardIndex.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</HeadContent>

<div class="dashboard-layout">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo"><i class="fas fa-user-shield"></i></div>
            <div class="logo-text"><h1>Jefe Brigada</h1></div>
        </div>
        <nav>
            <button class="menu-item active"><i class="fas fa-users"></i><span>Mi Personal</span></button>
            <button class="menu-item" onclick="location.href='/account/logout'">
                <i class="fas fa-sign-out-alt"></i><span>Salir</span>
            </button>
        </nav>
    </aside>

    <div class="main-area">
        <header class="header">
            <div class="header-actions">
                <div class="user-avatar" style="background-color: #c0392b;">
                    @(_currentUser.Name?.FirstOrDefault().ToString().ToUpper() ?? "J")
                </div>
                <span>@_currentUser.Name</span>
            </div>
        </header>

        <main class="main-content">
            <div class="dashboard-content">
                <h1>Personal a Cargo</h1>
                <p>Listado de usuarios registrados en: <strong>@_currentUser.School</strong></p>

                @if (usersInMySchool.Any())
                {
                    <div class="card p-3">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Rol</th>
                                    <th>Brigada</th>
                                    <th>Correo</th>
                                    <th>Teléfono</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in usersInMySchool)
                                {
                                    <tr>
                                        <td>@user.Name</td>
                                        <td><span class="badge bg-secondary">@user.Role</span></td>
                                        <td>
                                            @if (user.Brigade != null)
                                            {
                                                <span class="badge bg-info text-dark">@user.Brigade</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@user.Email</td>
                                        <td>@user.PhoneNumber</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">No se encontraron usuarios en tu facultad/escuela.</div>
                }
            </div>
        </main>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User _currentUser = new();
    private List<User> usersInMySchool = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (int.TryParse(userId, out int id))
            {
                var user = await RepoUsers.Get(id);
                if (user is not null) _currentUser = user;
            }
        }

        var allUsers = await RepoUsers.GetAll();
        if (!string.IsNullOrEmpty(_currentUser.School))
        {
            usersInMySchool = allUsers
                .Where(u => u.School == _currentUser.School && u.Id != _currentUser.Id)
                .ToList();
        }
    }
}
