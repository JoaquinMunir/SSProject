@page "/dashboard_auxiliar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "auxiliar")]
@inject IRepoUsers RepoUsers

<PageTitle>Panel de Auxiliar</PageTitle>

<PanelShell CurrentUser="_currentUser" Active="/dashboard_auxiliar">
    <h1>Comunidad Universitaria</h1>
    <p>Personas registradas en: <strong>@_currentUser.School</strong></p>

    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <h3>@usersInMySchool.Count</h3>
                <small>Personas registradas en tu facultad</small>
            </div>
        </div>
    </div>

    @if (usersInMySchool.Any())
    {
        <div class="card">
            <div class="card-header bg-success text-white">Listado informativo (solo lectura)</div>
            <ul class="list-group list-group-flush">
                @foreach (var user in usersInMySchool)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@user.Name</strong>
                            <br />
                            <small class="text-muted">@user.Role.GetDisplayName()@(user.Brigade != null ? $" · {user.Brigade.GetDisplayName()}" : "")</small>
                        </div>
                        <span class="badge bg-light text-dark border" title="Tipo de sangre">@user.Blood</span>
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <div class="alert alert-warning">No se encontraron usuarios en tu facultad o escuela.</div>
    }

</PanelShell>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User _currentUser = new();

    private async Task CargarUsuarioActual()
    {
        if (AuthStateTask is null) return;
        var authState = await AuthStateTask;
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userId, out int id))
        {
            var user = await RepoUsers.Get(id);
            if (user is not null) _currentUser = user;
        }
    }

    private List<User> usersInMySchool = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarioActual();
        if (string.IsNullOrEmpty(_currentUser.School)) return;

        var allUsers = await RepoUsers.GetAll();
        usersInMySchool = allUsers
            .Where(u => u.School == _currentUser.School && u.Id != _currentUser.Id)
            .OrderBy(u => u.Name)
            .ToList();
    }
}
