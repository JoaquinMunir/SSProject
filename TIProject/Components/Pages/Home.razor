@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.WebUtilities
@using TIProject.Data
@inject NavigationManager Navigation
@inject IRepoCourses RepoCourses
@inject IJSRuntime JS
@inject TIProject.Data.Documents DocService

<HeadContent>
    <link href="css/index.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</HeadContent>

<PageTitle>Protección Civil Universitaria</PageTitle>

<div class="index-layout">
    <div class="index-sidebar">
        <div class="logo-container">
            <div class="logo">
                <img src="https://scontent.fgdl1-4.fna.fbcdn.net/v/t39.30808-6/366363668_303940608852149_6787316479605237740_n.jpg?_nc_cat=109&ccb=1-7&_nc_sid=6ee11a&_nc_ohc=sLX8hlkLO8IQ7kNvwEpBzyq&_nc_oc=AdrxTZO877P_c0MHrkudLTJ4tqq9zvEv0Njd7VxIRLZCozTY8fGKZ2GixH9dygB4vvI&_nc_zt=23&_nc_ht=scontent.fgdl1-4.fna&_nc_gid=ObmWazvmR51FbKwHD6HzHA&_nc_ss=7b289&oh=00_Af7Lm10LB1u2-8QBBwNFb59018xfzIXqC7rrtl3rnHTn8g&oe=6A163697">

            </div>
            <div class="logo-text">

                <h1>Protección Civil</h1>
            </div>
        </div>

        <nav class="index-nav">
            <button class="nav-btn @(currentSection=="inicio"?"active":"")" @onclick='() => SelectSection("inicio")'>
                <div style="font-weight: 600; font-size: 15px;">Inicio</div>
                <div style="font-size: 11px; opacity: 0.7; margin-top: 2px;">Página Principal</div>
            </button>

            <button class="nav-btn @(currentSection=="servicios"?"active":"")" @onclick='() => SelectSection("servicios")'>
                <div style="font-weight: 600; font-size: 15px;">Servicios</div>
                <div style="font-size: 11px; opacity: 0.7; margin-top: 2px;">Nuestros servicios</div>
            </button>

            <button class="nav-btn @(currentSection=="mision"?"active":"")" @onclick='() => SelectSection("mision")'>
                <div style="font-weight: 600; font-size: 15px;">Misión</div>
                <div style="font-size: 11px; opacity: 0.7; margin-top: 2px;">Proteger, Prevenir y Servir</div>
            </button>

            <button class="nav-btn @(currentSection=="vision"?"active":"")" @onclick='() => SelectSection("vision")'>
                <div style="font-weight: 600; font-size: 15px;">Visión</div>
                <div style="font-size: 11px; opacity: 0.7; margin-top: 2px;">Una comunidad segura</div>
            </button>

            <button class="nav-btn @(currentSection=="objetivo"?"active":"")" @onclick='() => SelectSection("objetivo")'>
                <div style="font-weight: 600; font-size: 15px;">Objetivo</div>
                <div style="font-size: 11px; opacity: 0.7; margin-top: 2px;">Prevenir y mitigar desastres</div>
            </button>

            <button class="nav-btn @(currentSection=="contacto"?"active":"")" @onclick='() => SelectSection("contacto")'>
                <div style="font-weight: 600; font-size: 15px;">Contacto</div>
                <div style="font-size: 11px; opacity: 0.7; margin-top: 2px;">Ponte en contacto</div>
            </button>

            <button class="nav-btn" onclick="location.href='/roleSelection'">
                <div style="font-weight: 600; font-size: 15px; background: linear-gradient(135deg, #64B32E 0%, #527630 100%); color: white; box-shadow: 0 4px 12px rgba(74, 107, 93, 0.3); width: 100%; padding: 15px; border: none; border-radius: 8px; cursor: pointer; text-align: left; transition: all 0.3s ease; margin-bottom: 5px;">
                    Iniciar Sesion
                </div>
            </button>
        </nav>
    </div>

    <div class="main-content-index">

        @if (currentSection == "inicio")
        {
            <div class="content-column-grid">
                <div class="card center" style="max-height: 600px">
                    <div class="multimedia-header">Multimedia</div>
                    <div class="content-grid" style="max-height: 600px">
                        <div class="right-column">
                            <div class="card multimedia-item">
                                <h3>Firma de Convenio de Colaboración con PC Jalisco</h3>
                                <div class="multimedia-item-img">
                                    <img src="http://farm8.staticflickr.com/65535/52162125805_059ea8aca0_b.jpg" alt="Reunión Semanal de Protección Civil">
                                </div>
                            </div>
                            <div class="card multimedia-item">
                                <h3>Reunión Semanal de Protección Civil</h3>
                                <div class="multimedia-item-img">
                                    <img src="http://farm8.staticflickr.com/65535/52146731391_3fa6d6fdeb_b.jpg" alt="Reunión Semanal de Protección Civil">
                                </div>
                            </div>
                            <div class="card multimedia-item">
                                <h3>Instalación del Consejo Estatal de Protección Civil</h3>
                                <div class="multimedia-item-img">
                                    <img src="http://farm8.staticflickr.com/65535/52133199007_002c997b83_b.jpg" alt="Reunión Semanal de Protección Civil">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="content-grid">
                    <div class="card noticia-card">
                        <div>
                            <div style="font-size: 56px; font-weight: 700; color: #4a4a4a; line-height: 1;">17</div>
                            <div style="font-size: 14px; color: #666; margin-top: 10px; font-weight: 600;">OCT</div>
                        </div>
                        <div class="noticia-contenido">
                            <h2 style="font-size: 28px; font-weight: 700; color: #333; margin: 20px 0; line-height: 1.3;">
                                Max evolucionó a tormenta tropical, ocasionará lluvias intensas en algunas zonas de Colima
                            </h2>
                            <p style="color: #666; font-size: 15px; line-height: 1.6; margin: 0 0 25px 0;">
                                <strong>* UEPC mantiene en vigilancia su evolución,</strong><br>
                                se espera oleaje de 4 a 6 metros de altura en costas Colima
                            </p>
                        </div>
                        <div class="noticias-footer">
                            <button class="ver-mas-btn">Ver más</button>
                        </div>
                    </div>

                    <div class="boletines-container">
                        <div class="boletines-header">
                            <h2>Documentos Recientes</h2>
                        </div>

                        <ul class="boletines-list">
                            @if (DocService.GetAll().Any())
                            {
                                @foreach (var doc in DocService.GetAll().OrderByDescending(d => d.UploadDate).Take(5))
                                {
                                    <li class="boletin-item">
                                        <div class="boletin-info">
                                            <span class="boletin-date">@doc.UploadDate.ToString("dd MMM")</span>
                                            <span class="boletin-title">@doc.Title</span>
                                            <span class="badge bg-secondary" style="font-size: 0.7em;">@doc.Category</span>
                                        </div>

                                        @* ⬇️ Botón de Descarga Real (Con barra / al inicio para ruta absoluta) *@
                                        <a href="/uploads/@doc.FileName" download target="_blank" class="btn-descarga-mini" title="Descargar @doc.FileName">
                                            <i class="fas fa-download"></i>
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li style="padding: 10px; color: #666; text-align: center;">
                                    <small>No hay documentos publicados hoy.</small>
                                </li>
                            }
                        </ul>

                        <div class="boletines-footer">
                            <button class="ver-mas-btn" @onclick='() => SelectSection("servicios")'>Ver todos</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (currentSection == "servicios")
        {
            <div class="servicios-container">
                <div class="card center servicios" style="max-height: 200px">
                    <div class="servicios-header">
                        <h2 style="font-size: 36px; font-weight: 700; margin: 0 0 10px 0;">Nuestros Servicios</h2>
                        <p style="font-size: 24px; margin-bottom: 8px;">Ofrecemos una amplia gama de servicios para proteger a nuestra comunidad</p>
                    </div>
                </div>

                <div class="documentos-descarga" style="margin-top:50px">
                    <h3 style="margin-bottom:20px">📥 Archivos para descargar</h3>

                    @if (DocService.GetAll().Any())
                    {
                        <div style="display:flex; gap:10px; flex-wrap:wrap;">
                            @foreach (var doc in DocService.GetAll())
                            {
                                <a href="/uploads/@doc.FileName" download target="_blank" class="btn-descarga" style="text-decoration:none;">
                                    <i class="fas fa-file-download"></i> @doc.Title
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <button class="btn-descarga" @onclick="DescargarGuia">
                            <i class="fas fa-file-download"></i> Guía rápida (Demo)
                        </button>
                    }
                </div>

                <div class="cursos-seccion" style="margin-top: 50px; margin-bottom: 50px;">
                    <h3 style="font-size: 28px; font-weight: 700; color: #333; margin-bottom: 25px; border-bottom: 2px solid #ddd; padding-bottom: 10px;">
                        📚 Cursos de Capacitación disponibles
                    </h3>
                    <div class="cursos-grid">
                        @if (allCourses != null && allCourses.Any())
                        {
                            @foreach (var course in allCourses)
                            {
                                <div class="curso-tarjeta card" @onclick="() => SeleccionarServicio(course.Id, true)" style="cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                    <div class="tarjeta-icono" style="text-align: center; margin-bottom: 15px;">
                                        <i class="fas fa-kit-medical" style="font-size: 3.5rem; color: #4CAF50;"></i>
                                    </div>
                                    <div class="tarjeta-contenido">
                                        <h4 style="font-size: 1.25rem; font-weight: 600; margin-top: 0;">@course.Name</h4>
                                        <p class="tarjeta-descripcion" style="font-size: 0.9rem; color: #666;">
                                            Curso presencial de Protección Civil.
                                        </p>
                                        <p style="font-size: 0.8rem; color: #999; margin-top: 5px;">Fecha: @course.Date.ToString("dd/MM/yyyy") - Lugar: @course.Place</p>
                                    </div>
                                    <button class="btn-inscribirse" style="background-color: #4CAF50; color: white; border: none; padding: 10px; border-radius: 4px; margin-top: 15px;">
                                        <i class="fas fa-user-plus me-2"></i> Inscribirse Ahora
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No hay cursos de capacitación disponibles actualmente.</p>
                        }
                    </div>
                </div>

                <div class="nota-informativa">
                    <i class="fas fa-info-circle"></i>
                    <p>Para más información sobre cualquier servicio, contáctanos al <strong>(312) 313-0311</strong></p>
                </div>
            </div>
        }

        @if (currentSection == "mision")
        {
            <div class="card content-page-card @currentSection-page">
                <div class="content-header">
                    <i class="content-page-icon fas fa-bullseye"></i>
                    <h2 class="content-page-title">Nuestra Misión</h2>
                </div>
                <div class="content-body">
                    <p class="content-page-text">La Unidad Estatal de Protección Civil tiene como misión salvaguardar a la población...</p>
                    <p class="content-page-text highlighted-text">"Salvaguardar a la población..."</p>
                </div>
            </div>
        }

        @if (currentSection == "vision")
        {
            <div class="card content-page-card @currentSection-page">
                <div class="content-header">
                    <i class="content-page-icon fas fa-eye"></i>
                    <h2 class="content-page-title">Nuestra Visión</h2>
                </div>
                <div class="content-body">
                    <p class="content-page-text">Ser la instancia líder en Protección Civil...</p>
                    <p class="content-page-text highlighted-text">"Ser una instancia de excelencia..."</p>
                </div>
            </div>
        }

        @if (currentSection == "objetivo")
        {
            <div class="card content-page-card @currentSection-page">
                <div class="content-header">
                    <i class="content-page-icon fas fa-crosshairs"></i>
                    <h2 class="content-page-title">Nuestro Objetivo</h2>
                </div>
                <div class="content-body">
                    <p class="content-page-text">Contribuir a la prevención y mitigación de desastres...</p>
                    <p class="content-page-text highlighted-text">"Contribuir a la prevención..."</p>
                </div>
            </div>
        }

        @if (currentSection == "contacto")
        {
            <div class="contacto-container">
                <div class="card center contacto-header-card">
                    <div class="contacto-header">
                        <h2>¡Contáctanos!</h2>
                        <p>Estamos aquí para ayudarte. Envíanos tu mensaje o consulta.</p>
                    </div>
                </div>

                <div class="contacto-content-grid">
                    <div class="card formulario-card">
                        <h3 class="formulario-titulo">Envíanos un mensaje</h3>
                        <div class="form-group">
                            <div class="input-icon"><i class="fas fa-user"></i></div>
                            <input type="text" placeholder="* Nombre" @bind="contactForm.Nombre" class="form-input" />
                        </div>
                        <div class="form-group">
                            <div class="input-icon"><i class="fas fa-phone"></i></div>
                            <input type="tel" placeholder="* Teléfono" @bind="contactForm.Telefono" class="form-input" />
                        </div>
                        <div class="form-group">
                            <div class="input-icon"><i class="fas fa-envelope"></i></div>
                            <input type="email" placeholder="* Correo" @bind="contactForm.Correo" class="form-input" />
                        </div>
                        <div class="form-group">
                            <select class="form-select" @bind="contactForm.Tema">
                                <option value="">Seleccionar el tema</option>
                                <option value="emergencia">Emergencia</option>
                                <option value="tramite">Trámite o Servicio</option>
                                <option value="informacion">Información General</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <textarea placeholder="¿Cuál es tu requerimiento?" @bind="contactForm.Mensaje" rows="5" class="form-textarea"></textarea>
                        </div>
                        <button class="btn-enviar" @onclick="EnviarFormulario">
                            <i class="fas fa-paper-plane"></i> Enviar
                        </button>
                    </div>

                    <div class="info-contacto-column">
                        <div class="card app-card">
                            <h3 class="info-titulo">Conoce nuestras aplicaciones</h3>
                            <p class="app-nombre">Descarga nuestra aplicación móvil <strong>Contacto Colima</strong></p>
                            <div class="app-buttons">
                                <button class="btn-app apple" @onclick='() => DescargarApp("ios")'><i class="fab fa-apple"></i></button>
                                <button class="btn-app android" @onclick='() => DescargarApp("android")'><i class="fab fa-android"></i></button>
                            </div>
                        </div>
                        <div class="card domicilio-card">
                            <h3 class="info-titulo">Nuestro domicilio</h3>
                            <div class="domicilio-info">
                                <p><strong>Unidad Estatal de Protección Civil</strong></p>
                                <p>Tel: (312)313-0311</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .boletines-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .boletin-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #eee;
    }

    .boletin-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .boletin-date {
        font-size: 0.75rem;
        color: #888;
        font-weight: 600;
    }

    .boletin-title {
        font-size: 0.95rem;
        font-weight: 500;
        color: #333;
    }

    .btn-descarga-mini {
        background-color: #f0f2f5;
        color: #333;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        text-decoration: none;
    }

        .btn-descarga-mini:hover {
            background-color: #007bff;
            color: white;
        }
</style>

@code {
    private string mError = "";
    private string currentSection = "inicio";
    private HashSet<string> categoriasAbiertas = new HashSet<string>();
    private List<Servicio> todosServicios = new List<Servicio>();
    private List<Course> allCourses = new List<Course>();

    private class ContactoFormModel
    {
        public string Nombre { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Correo { get; set; } = "";
        public string Tema { get; set; } = "";
        public string Mensaje { get; set; } = "";
    }

    private ContactoFormModel contactForm = new ContactoFormModel();

    private class Servicio
    {
        public int Numero { get; set; }
        public string Nombre { get; set; }
        public string Categoria { get; set; }
        public string Descripcion { get; set; } = "";
        public string Icono { get; set; } = "fas fa-file-alt";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allCourses = await RepoCourses.GetAll();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar cursos: {ex.Message}");
            allCourses = new List<Course>();
        }

        InitializeSimulatedData();

        // ✅ SUSCRIPCIÓN AL EVENTO: Actualiza la página cuando el admin sube algo
        DocService.OnChange += StateHasChanged;
    }

    // ✅ LIMPIEZA: Se desconecta del evento al salir de la página
    public void Dispose()
    {
        DocService.OnChange -= StateHasChanged;
    }

    private void InitializeSimulatedData()
    {
        todosServicios = new List<Servicio>
        {
            new Servicio {
                Numero = 1,
                Nombre = "Permiso e Inscripción de Consultor Externo",
                Categoria = "boletines",
                Descripcion = "Registro oficial para consultores.",
                Icono = "fas fa-file-contract"
            },
            new Servicio {
                Numero = 2,
                Nombre = "Permiso e Inscripción de Capacitador Externo",
                Categoria = "boletines",
                Descripcion = "Registro y autorización como capacitador.",
                Icono = "fas fa-chalkboard-teacher"
            }
        };
    }

    private void ToggleCategoria(string categoria)
    {
        if (categoriasAbiertas.Contains(categoria))
            categoriasAbiertas.Remove(categoria);
        else
            categoriasAbiertas.Add(categoria);
    }

    private void SeleccionarServicio(int id, bool isCourse)
    {
        if (isCourse)
            Navigation.NavigateTo($"/courseRegistration/{id}");
        else
            Navigation.NavigateTo($"/documentRegistration/{id}");
    }

    private void DescargarGuia()
    {
        string urlGuia = "/Guia.pdf";
        Navigation.NavigateTo(urlGuia, true);
    }

    private void SelectSection(string section)
    {
        currentSection = section;
        if (section != "servicios")
            categoriasAbiertas.Clear();
    }

    private void EnviarFormulario()
    {
        if (string.IsNullOrWhiteSpace(contactForm.Nombre) ||
            string.IsNullOrWhiteSpace(contactForm.Telefono) ||
            string.IsNullOrWhiteSpace(contactForm.Correo))
        {
            mError = "Por favor, completa todos los campos obligatorios.";
            return;
        }
        mError = "";
        Console.WriteLine("Formulario enviado.");
    }

    private void DescargarApp(string platform)
    {
        string url = platform == "ios" ? "https://www.apple.com/app-store/" : "https://play.google.com/store/apps";
        Navigation.NavigateTo(url, true);
    }
}