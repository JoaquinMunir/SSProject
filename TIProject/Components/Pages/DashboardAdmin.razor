@page "/dashboard_admin/"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin")]
@using System.Linq
@using System.Security.Claims
@inject NavigationManager Navigation
@inherits LayoutComponentBase
@inject IRepoUsers repoUsers
@inject IRepoCourses repoCourses
@inject IJSRuntime JS

<HeadContent>
    <link href="css/dashboardIndex.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</HeadContent>

<PageTitle>Dashboard - Administrador</PageTitle>

<div class="dashboard-layout">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div class="logo-text">
                <h1>Protección Civil</h1>
                <p>Panel Administrativo</p>
            </div>
        </div>
        <nav>
            <button type="button" class="menu-item active" @onclick="@(() => Navigation.NavigateTo("/dashboard_admin/"))">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </button>

            <button type="button" class="menu-item" @onclick="@(() => Navigation.NavigateTo("/dashboard_admin/courses"))">
                <i class="fas fa-users"></i>
                <span>Gestión de Cursos</span>
            </button>

            <button type="button" class="menu-item" @onclick="@(() => Navigation.NavigateTo("/dashboard_admin/users"))">
                <i class="fas fa-book"></i>
                <span>Gestión de Usuarios</span>
            </button>

            <button type="button" class="menu-item" @onclick="@(() => Navigation.NavigateTo("/dashboard_admin/documents"))">
                <i class="fas fa-file-alt"></i>
                <span>Gestión de Documentos</span>
            </button>
        </nav>
    </aside>

    <div class="main-area">
        <header class="header">
            <div class="header-actions">
                <button class="icon-btn" id="darkModeButton" type="button" onclick="toggleDarkMode()" aria-label="Toggle dark mode">
                    <i class="fas fa-moon" id="darkModeIcon"></i>
                </button>

                <button class="icon-btn" type="button" aria-label="Notificaciones">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge">3</span>
                </button>

                <div class="user-avatar" @onclick="ToggleUserMenu" title="@_user.Name">
                    @(!string.IsNullOrEmpty(_user.Name) ? _user.Name[0].ToString().ToUpper() : "U")
                </div>

                <div class="user-menu @(showUserMenu ? "show" : "")">
                    <p><strong>Nombre:</strong> @_user.Name</p>
                    <p><strong>Rol:</strong> @_user.Role.GetDisplayName()</p>
                </div>

                @code {
                    private bool showUserMenu = false;
                    private void ToggleUserMenu() { showUserMenu = !showUserMenu; }
                }

                <button class="icon-btn" type="button" aria-label="Salir"
                        onclick="location.href='/account/logout'">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </header>

        <main class="main-content">
            <div class="dashboard-content">
                <h1>Dashboard General</h1>
                <p>Resumen de actividad de Protección Civil</p>

                <div class="summary-section">
                    <div class="summary-card users-card" @onclick="@(() => Navigation.NavigateTo("/dashboard_admin/users"))" style="cursor: pointer;">
                        <div class="card-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="card-info">
                            <h3>Usuarios Registrados</h3>
                            <span class="card-number">@allUsers.Count()</span>
                        </div>
                    </div>

                    <div class="summary-card brigades-card">
                        <div class="card-icon">
                            <i class="fas fa-hard-hat"></i>
                        </div>
                        <div class="card-info">
                            <h3>Brigadas Activas</h3>
                            <span class="card-number">
                                @allUsers.Where(u => u.Brigade != null).Select(u => u.Brigade).Distinct().Count()
                            </span>
                        </div>
                    </div>

                    <div class="summary-card courses-card" @onclick="@(() => Navigation.NavigateTo("/dashboard_admin/courses"))" style="cursor: pointer;">
                        <div class="card-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="card-info">
                            <h3>Cursos Programados</h3>
                            <span class="card-number">
                                @allCourses.Count(c => c.Date >= DateTime.Today)
                            </span>
                        </div>
                    </div>
                </div>

                <div class="quick-actions" style="margin-top: 30px; background: #f8fafc; padding: 25px; border-radius: 12px; border: 1px solid #e2e8f0;">
                    <h3 style="margin-bottom: 20px; color: #1e293b; font-size: 1.25rem; font-weight: 700;">Acciones Rápidas</h3>
                    <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                        <button class="btn btn-primary" style="padding: 12px 24px; border-radius: 8px; font-weight: 600; display: flex; align-items: center; gap: 8px;" @onclick="@(() => Navigation.NavigateTo("/add"))">
                            <i class="fas fa-user-plus"></i> Nuevo Usuario
                        </button>
                        <button class="btn btn-success" style="padding: 12px 24px; border-radius: 8px; background-color: #10b981; border: none; color: white; font-weight: 600; display: flex; align-items: center; gap: 8px;" @onclick="@(() => Navigation.NavigateTo("/addCourse"))">
                            <i class="fas fa-calendar-plus"></i> Nuevo Curso
                        </button>
                    </div>
                </div>

                <div style="margin-top: 40px;">
                    <h3 style="margin-bottom: 20px; color: #444;">Desglose por Brigada</h3>

                    @if (allUsers.Any(u => u.Brigade != null))
                    {
                        <div class="brigade-grid">
                            @foreach (var grupo in allUsers.Where(u => u.Brigade != null).GroupBy(u => u.Brigade))
                            {
                                <div class="brigade-detail-card">
                                    <div class="brigade-header">
                                        <i class="fas fa-shield-virus"></i>
                                        <h4>@grupo.Key.GetDisplayName()</h4>
                                    </div>
                                    <div class="brigade-body">
                                        <span class="member-count">@grupo.Count() Miembros</span>
                                        <div class="progress-bar-bg">
                                            <div class="progress-bar-fill" style="width: @(Math.Min(100, (grupo.Count() * 100) / 20))%"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">No hay usuarios asignados a brigadas todavía.</div>
                    }
                </div>
            </div>
        </main>
    </div>
</div>

<style>
    .summary-section { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .summary-card { background: white; border-radius: 12px; padding: 25px; display: flex; align-items: center; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.2s; border-left: 5px solid #ddd; }
    .summary-card:hover { transform: translateY(-5px); }
    .card-icon { width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; margin-right: 20px; }
    .card-info h3 { margin: 0; font-size: 16px; color: #666; font-weight: 600; }
    .card-number { font-size: 36px; font-weight: 700; color: #333; line-height: 1.2; }
    .users-card { border-left-color: #3b82f6; }
    .users-card .card-icon { background-color: #eff6ff; color: #3b82f6; }
    .brigades-card { border-left-color: #f59e0b; }
    .brigades-card .card-icon { background-color: #fffbeb; color: #f59e0b; }
    .courses-card { border-left-color: #10b981; }
    .courses-card .card-icon { background-color: #ecfdf5; color: #10b981; }
    .brigade-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
    .brigade-detail-card { background: white; padding: 20px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid #eee; }
    .brigade-header { display: flex; align-items: center; margin-bottom: 15px; color: #444; }
    .brigade-header i { margin-right: 10px; color: #f59e0b; }
    .brigade-header h4 { margin: 0; font-size: 16px; font-weight: 600; }
    .member-count { display: block; font-size: 20px; font-weight: 700; color: #333; margin-bottom: 10px; }
    .progress-bar-bg { width: 100%; height: 6px; background-color: #eee; border-radius: 3px; overflow: hidden; }
    .progress-bar-fill { height: 100%; background-color: #f59e0b; border-radius: 3px; }
    body.dark-mode .summary-card, body.dark-mode .brigade-detail-card, body.dark-mode .quick-actions { background: #1a202c; border-color: #4a5568; }
    body.dark-mode .card-number, body.dark-mode .member-count, body.dark-mode .quick-actions h3 { color: white; }
    body.dark-mode .brigade-header h4, body.dark-mode .card-info h3 { color: #cbd5e0; }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User _user = new();
    private List<User> allUsers = new();
    private List<Course> allCourses = new();

    protected override async Task OnInitializedAsync()
    {
        allUsers = await repoUsers.GetAll();
        allCourses = await repoCourses.GetAll();

        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (int.TryParse(userId, out int id))
            {
                var userDb = allUsers.FirstOrDefault(u => u.Id == id);
                if (userDb is not null) _user = userDb;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("initDarkMode"); } catch { }
        }
    }
}
