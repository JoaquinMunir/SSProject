@page "/dashboard_admin/courses"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inherits LayoutComponentBase
@inject IRepoUsers repoUsers
@inject IRepoCourses repoCourses
@inject IJSRuntime JS

<HeadContent>
    <link href="css/dashboardIndex.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</HeadContent>

<PageTitle>Cursos - Administrador</PageTitle>

<div class="dashboard-layout">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div class="logo-text">
                <h1>Protección Civil</h1>
                <p>Panel Administrativo</p>
            </div>
        </div>
        <nav>
            <button type="button" class="menu-item" @onclick="@(() => NavigateTo("/dashboard_admin/"))">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </button>

            <button type="button" class="menu-item active" @onclick="@(() => NavigateTo("/dashboard_admin/courses"))">
                <i class="fas fa-users"></i>
                <span>Gestión de Cursos</span>
            </button>

            <button type="button" class="menu-item" @onclick="@(() => NavigateTo("/dashboard_admin/users"))">
                <i class="fas fa-book"></i>
                <span>Gestión de Usuarios</span>
            </button>

            <button type="button" class="menu-item" @onclick="@(() => NavigateTo("/dashboard_admin/documents"))">
                <i class="fas fa-file-alt"></i>
                <span>Gestión de Documentos</span>
            </button>

        </nav>
    </aside>

    <div class="main-area">
        <header class="header">
            <div class="header-actions">
                <button class="icon-btn" id="darkModeButton" type="button" onclick="toggleDarkMode()" aria-label="Toggle dark mode">
                    <i class="fas fa-moon" id="darkModeIcon"></i>
                </button>

                <button class="icon-btn" type="button" aria-label="Notificaciones">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge">2</span>
                </button>

                <div class="user-avatar" @onclick="ToggleUserMenu" title="@_user.Name">
                    @(!string.IsNullOrEmpty(_user.Name) ? _user.Name[0].ToString().ToUpper() : "A")
                </div>

                <div class="user-menu @(showUserMenu ? "show" : "")">
                    <p><strong>Nombre:</strong> @_user.Name</p>
                    <p><strong>Rol:</strong> @_user.Role.GetDisplayName()</p>
                </div>

                @code {
                    private bool showUserMenu = false;
                    private void ToggleUserMenu() { showUserMenu = !showUserMenu; }
                }

                <button class="icon-btn" type="button" aria-label="Salir" onclick="location.href='/roleSelection'">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </header>

        <main class="main-content">

            <div class="dashboard-content">
                <h1>Gestión de Cursos</h1>
                <p>Panel de administración y programación de capacitaciones</p>

                <div class="summary-section">

                    <div class="summary-card total-courses">
                        <div class="card-icon">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <div class="card-info">
                            <h3>Total Cursos</h3>
                            <span class="card-number">@allCourses.Count()</span>
                        </div>
                    </div>

                    <div class="summary-card upcoming-courses">
                        <div class="card-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div class="card-info">
                            <h3>Próximos</h3>
                            <span class="card-number">
                                @allCourses.Count(c => c.Date >= DateTime.Today)
                            </span>
                        </div>
                    </div>

                    <div class="summary-card past-courses">
                        <div class="card-icon">
                            <i class="fas fa-history"></i>
                        </div>
                        <div class="card-info">
                            <h3>Realizados</h3>
                            <span class="card-number">
                                @allCourses.Count(c => c.Date < DateTime.Today)
                            </span>
                        </div>
                    </div>

                </div>
                <div style="margin: 20px 0;">
                    <button class="btn btn-primary" type="button" onclick="location.href='/addCourse'">
                        <i class="fas fa-plus me-2"></i> Nuevo Curso
                    </button>
                </div>

                @if (allCourses.Count() > 0)
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>Fecha</th>
                                <th>Lugar</th>
                                <th>Encargado</th>
                                <th>Estado</th>
                                <th>Editar</th>
                                <th>Eliminar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in allCourses)
                            {
                                <tr>
                                    <td>@course.Id</td>
                                    <td>@course.Name</td>
                                    <td>@course.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@course.Place</td>
                                    <td>@(course.User != null ? course.User.Name : "Sin asignar")</td>

                                    <td>
                                        @if (course.Date >= DateTime.Today)
                                        {
                                            <span class="badge bg-success">Próximo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Finalizado</span>
                                        }
                                    </td>

                                    <td>
                                        <button class="btn btn-outline-secondary" title="Editar" @onclick="@(()=>Editar(course.Id))">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                            </svg>
                                        </button>
                                    </td>

                                    <td>
                                        <button class="btn btn-outline-secondary" title="Eliminar" @onclick="@(()=>Eliminar(course))">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                                <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </main>
    </div>
</div>

@* Estilos CSS locales para las tarjetas de resumen *@
<style>
    .summary-section {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .summary-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-left: 5px solid #ddd;
    }

        .summary-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }

    .card-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-right: 15px;
    }

    .card-info h3 {
        margin: 0;
        font-size: 14px;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card-number {
        font-size: 28px;
        font-weight: 700;
        color: #333;
        line-height: 1.2;
    }

    /* Estilos Específicos para Cursos */
    .total-courses {
        border-left-color: #0d6efd; /* Azul */
    }

        .total-courses .card-icon {
            background-color: rgba(13, 110, 253, 0.15);
            color: #0d6efd;
        }

    .upcoming-courses {
        border-left-color: #198754; /* Verde */
    }

        .upcoming-courses .card-icon {
            background-color: rgba(25, 135, 84, 0.15);
            color: #198754;
        }

    .past-courses {
        border-left-color: #6c757d; /* Gris */
    }

        .past-courses .card-icon {
            background-color: rgba(108, 117, 125, 0.15);
            color: #6c757d;
        }

    /* Badges para la tabla */
    .badge {
        padding: 5px 10px;
        border-radius: 12px;
        color: white;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .bg-success {
        background-color: #198754;
    }

    .bg-secondary {
        background-color: #6c757d;
    }

    /* Dark Mode adjustments */
    body.dark-mode .summary-card {
        background: #1a202c;
        border-left: 5px solid #4a5568;
    }

    body.dark-mode .card-info h3 {
        color: #a0aec0;
    }

    body.dark-mode .card-number {
        color: #fff;
    }
</style>

@code
{
    private User _user = new();
    private List<User> allUsers = new();
    private List<Course> allCourses = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("initDarkMode"); } catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Carga de datos
        allUsers = await repoUsers.GetAll();
        allCourses = await repoCourses.GetAll();

        // Lógica para obtener el usuario actual desde la URL (para mantener sesión en admin panel)
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var queryDict = QueryHelpers.ParseQuery(uri.Query);
            if (queryDict.TryGetValue("id", out var idInt) && int.TryParse(idInt, out int id))
            {
                var userDB = allUsers.FirstOrDefault(u => u.Id == id);
                if (userDB != null)
                {
                    _user = userDB;
                }
            }
        }
        Console.WriteLine($"El usuario {_user.Name} acaba de ingresar al panel de cursos");
    }

    private void NavigateTo(string page)
    {
        if (_user != null && _user.Id > 0)
            Navigation.NavigateTo($"{page}?id={_user.Id}");
        else
            Navigation.NavigateTo(page);
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/editCourse/{id}");
    }

    private async void Eliminar(Course course)
    {
        bool confirmDelete = await JS.InvokeAsync<bool>("confirm", $"¿Seguro que deseas eliminar el curso '{course.Name}'?");

        if (confirmDelete)
        {
            await repoCourses.Delete(course.Id);
            allCourses = await repoCourses.GetAll(); // Recargar lista
            StateHasChanged(); // Actualizar UI
        }
    }
}