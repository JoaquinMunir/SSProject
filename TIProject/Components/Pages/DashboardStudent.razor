@page "/dashboard_student"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "student")]
@inject NavigationManager Navigation
@inject IRepoCourses RepoCourses
@inject IRepoUsers RepoUsers
@inject IJSRuntime JS

<HeadContent>
    <link href="css/dashboardIndex.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</HeadContent>

<div class="dashboard-layout">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo"><i class="fas fa-user-graduate"></i></div>
            <div class="logo-text"><h1>Estudiante</h1></div>
        </div>
        <nav>
            <button class="menu-item active"><i class="fas fa-book-open"></i><span>Mis Cursos</span></button>
            <button class="menu-item" onclick="location.href='/account/logout'">
                <i class="fas fa-sign-out-alt"></i><span>Salir</span>
            </button>
        </nav>
    </aside>

    <div class="main-area">
        <header class="header">
            <div class="header-actions">
                <div class="user-avatar">@(_currentUser.Name?.FirstOrDefault().ToString().ToUpper() ?? "E")</div>
                <span style="margin-left:10px; font-weight:bold;">@_currentUser.Name</span>
            </div>
        </header>

        <main class="main-content">
            <div class="dashboard-content">
                <h1>Panel de Estudiante</h1>
                <p>Gestiona tus inscripciones y capacitación.</p>

                <div class="mb-5">
                    <h3><i class="fas fa-check-circle text-success"></i> Mis Inscripciones</h3>
                    <div class="alert alert-info">
                        No tienes cursos activos en este momento.
                    </div>
                </div>

                <h3><i class="fas fa-list"></i> Cursos Disponibles para ti</h3>

                @if (availableCourses.Any())
                {
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 15px;">
                        @foreach (var course in availableCourses)
                        {
                            <div class="card p-3 shadow-sm" style="border-top: 4px solid #0d6efd;">
                                <h4>@course.Name</h4>
                                <p class="text-muted" style="font-size: 0.9rem;">@course.Place</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="badge bg-light text-dark">@course.Date.ToString("dd/MM/yyyy")</span>
                                    <button class="btn btn-primary btn-sm" @onclick="() => Inscribirse(course)">
                                        Inscribirse
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>No hay cursos abiertos por el momento.</p>
                }
            </div>
        </main>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User _currentUser = new();
    private List<Course> availableCourses = new();

    protected override async Task OnInitializedAsync()
    {
        availableCourses = await RepoCourses.GetAll();

        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (int.TryParse(userId, out int id))
            {
                var user = await RepoUsers.Get(id);
                if (user is not null) _currentUser = user;
            }
        }
    }

    private async Task Inscribirse(Course course)
    {
        await JS.InvokeVoidAsync("alert", $"Solicitud enviada para: {course.Name}");
    }
}
