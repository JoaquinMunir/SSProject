@page "/dashboard_admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin")]
@using System.Linq
@inject NavigationManager Navigation
@inject IRepoUsers repoUsers
@inject IRepoCourses repoCourses
@inject IJSRuntime JS

<PageTitle>Usuarios - Administrador</PageTitle>

<PanelShell CurrentUser="_user" Active="/dashboard_admin/users">
                <h1>Gestión de Usuarios</h1>
                <p>Alta, edición y baja de los usuarios del sistema</p>

                <div class="summary-section">
                    <div class="summary-card total-users">
                        <div class="card-icon"><i class="fas fa-users"></i></div>
                        <div class="card-info">
                            <h3>Total Usuarios</h3>
                            <span class="card-number">@allUsers.Count()</span>
                        </div>
                    </div>

                    @if (allUsers.Any())
                    {
                        @foreach (var grupo in allUsers.Where(u => u.Brigade != null).GroupBy(u => u.Brigade))
                        {
                            <div class="summary-card brigade-card">
                                <div class="card-icon brigade-icon"><i class="fas fa-hard-hat"></i></div>
                                <div class="card-info">
                                    <h3>@grupo.Key.GetDisplayName()</h3>
                                    <span class="card-number">@grupo.Count()</span>
                                </div>
                            </div>
                        }

                        @if (allUsers.Count(u => u.Brigade == null) > 0)
                        {
                            <div class="summary-card gray-card">
                                <div class="card-icon"><i class="fas fa-user-tag"></i></div>
                                <div class="card-info">
                                    <h3>Sin Brigada</h3>
                                    <span class="card-number">@allUsers.Count(u => u.Brigade == null)</span>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div style="margin: 20px 0;">
                    <button class="btn btn-primary" type="button" @onclick="@(() => Navigation.NavigateTo("/add"))">
                        <i class="fas fa-plus me-2"></i> Nuevo Usuario
                    </button>
                </div>

                @if (allUsers.Count() > 0)
                {
                    <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Credencial</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Domicilio</th>
                                <th>Escuela</th>
                                <th>Brigada</th>
                                <th>Rol</th>
                                <th>Editar</th>
                                <th>Eliminar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in allUsers)
                            {
                                <tr>
                                    <td>@user.Name</td>
                                    <td>@user.IdNumber</td>
                                    <td>@user.Email</td>
                                    <td>@user.PhoneNumber</td>
                                    <td>@user.Address</td>
                                    <td>@user.School</td>
                                    @if (user.Brigade != null) { <td>@user.Brigade.GetDisplayName()</td> } else { <td>-</td> }
                                    <td>@user.Role.GetDisplayName()</td>
                                    <td>
                                        <button class="btn btn-outline-secondary" title="Editar" @onclick="@(()=>Editar(user.Id))">
                                            <i class="fas fa-pencil-square"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-danger" title="Eliminar" @onclick="@(()=>Eliminar(user))">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
</PanelShell>

<style>
    .summary-section { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .summary-card { background: white; border-radius: 12px; padding: 20px; display: flex; align-items: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05); transition: transform 0.2s ease; border-left: 5px solid #ddd; }
    .summary-card:hover { transform: translateY(-5px); }
    .card-icon { width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; margin-right: 15px; }
    .card-info h3 { margin: 0; font-size: 14px; color: #666; text-transform: uppercase; }
    .card-number { font-size: 28px; font-weight: 700; color: #333; }
    .total-users { border-left-color: #64B32E; } .total-users .card-icon { background-color: rgba(100,179,46,.15); color: #64B32E; }
    .brigade-card { border-left-color: #3498db; } .brigade-card .card-icon { background-color: rgba(52,152,219,.15); color: #3498db; }
    .gray-card { border-left-color: #95a5a6; } .gray-card .card-icon { background-color: rgba(149,165,166,.15); color: #95a5a6; }
    body.dark-mode .summary-card { background: #1a202c; border-left: 5px solid #4a5568; }
    body.dark-mode .card-info h3 { color: #a0aec0; } body.dark-mode .card-number { color: #fff; }
</style>

@code
{
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private User _user = new();
    private List<User> allUsers = new();
    private List<Course> allCourses = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("initDarkMode"); } catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        allUsers = await repoUsers.GetAll();
        allCourses = await repoCourses.GetAll();

        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (int.TryParse(userId, out int id))
            {
                var userDb = allUsers.FirstOrDefault(u => u.Id == id);
                if (userDb is not null) _user = userDb;
            }
        }
    }

    private void Editar(int id) => Navigation.NavigateTo($"/edit/{id}");

    private async Task Eliminar(User user)
    {
        bool confirmDelete = await JS.InvokeAsync<bool>("confirm", $"¿Seguro que deseas eliminar el usuario '{user.Name}'?");
        if (!confirmDelete) return;

        if (allCourses.Any(c => c.IdManager == user.Id))
        {
            await JS.InvokeVoidAsync("alert", $"No se puede eliminar a '{user.Name}' porque es encargado de uno o más cursos. Asigna otro encargado primero.");
            return;
        }
        if (user.Id == _user.Id)
        {
            await JS.InvokeVoidAsync("alert", "No puedes eliminar tu propia cuenta.");
            return;
        }

        await repoUsers.Delete(user.Id);
        allUsers = await repoUsers.GetAll();
        StateHasChanged();
    }
}
